# Copy this file to .env and fill in the real values. Never commit .env.

# Bot token from the Discord Developer Portal. This is a secret.
DISCORD_TOKEN=
# Application ID, also from the Discord Developer Portal.
DISCORD_CLIENT_ID=
# Server where /getkey and /revoke-key are registered.
DISCORD_GUILD_ID=
# Optional extra servers, separated by commas. Each server still needs an admin connection in the API.
DISCORD_GUILD_IDS=

# Worker URL. Use http://127.0.0.1:8787 only on your own computer.
ZERVXHUB_API_URL=https://YOUR-WORKER.workers.dev
# Private bot credential created for the Worker secret BOT_API_TOKEN.
# Do not put the worker ADMIN_TOKEN here.
ZERVXHUB_BOT_TOKEN=
